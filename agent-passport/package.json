{
  "name": "agent-passport",
  "version": "0.1.0",
  "private": true,
  "description": "Midnight reference dApp: an AI agent proves it is backed by an enrolled human without revealing which one.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contract/agent-passport.compact contract/managed/agent-passport",
    "compile:fast": "compact compile --skip-zk contract/agent-passport.compact contract/managed/agent-passport",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run .sim.test.ts",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "test:devnet": "NODE_OPTIONS='--experimental-vm-modules' vitest run .devnet.test.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.5",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnight-ntwrk/testkit-js": "5.0.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0",
    "@midnightntwrk/zkir-v3": "3.2.0"
  }
}
